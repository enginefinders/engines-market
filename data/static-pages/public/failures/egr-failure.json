    "urgency": {
      "items": [
        {
          "id": "understanding-the-severity-of-your-egr-issue",
          "title": "Understanding The Severity Of Your EGR Issue",
          "description": "Understanding the severity of your EGR issue is critical to avoiding unnecessary replacement costs.",
          "blocks": [
            {
              "type": "cards",
              "cards": [
                {
                  "title": "STAGE 1",
                  "text": "Slight loss of power, occasional rough idle Minor carbon accumulation",
                  "highlight": "£70",
                  "meta": "STAGE 1",
                  "icon": "",
                  "items": [],
                  "fullText": "STAGE 1 £70 Slight loss of power, occasional rough idle Minor carbon accumulation £70 – £120"
                },
                {
                  "title": "STAGE 2",
                  "text": "Persistent rough idle, black smoke, increased fuel consumption Heavy carbon build-up – valve mechanically stuck",
                  "highlight": "£135",
                  "meta": "STAGE 2",
                  "icon": "",
                  "items": [],
                  "fullText": "STAGE 2 £135 Persistent rough idle, black smoke, increased fuel consumption Heavy carbon build-up – valve mechanically stuck £70–£120 (clean) or £135–£650 (replace)"
                },
                {
                  "title": "STAGE 3",
                  "text": "Engine management light, limp mode, failed MOT emissions Valve motor failure, cracked housing, or severe blockage",
                  "highlight": "£650",
                  "meta": "STAGE 3",
                  "icon": "",
                  "items": [],
                  "fullText": "STAGE 3 £650 Engine management light, limp mode, failed MOT emissions Valve motor failure, cracked housing, or severe blockage £135 – £650"
                }
              ]
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "LIKELY CAUSE"
            },
            {
              "type": "paragraph",
              "text": "Minor carbon accumulation restricting valve movement. Often caused by short journeys and urban driving."
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "WHAT TO DO"
            },
            {
              "type": "paragraph",
              "text": "Book professional EGR cleaning. The valve is removed and chemically cleaned to dissolve carbon deposits."
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "REPAIR COST"
            },
            {
              "type": "paragraph",
              "text": "£70–£120 for professional cleaning. Labour: 1–2 hours at £65–£95/hr."
            },
            {
              "type": "paragraph",
              "text": "⚠️"
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "Illegal EGR Blanking – Do Not Allow This"
            },
            {
              "type": "paragraph",
              "text": "Under UK law (The Road Vehicles (Construction and Use) Regulations 1986), removing, blanking, or modifying an EGR system is illegal. It is classified as tampering with the vehicle's mandatory emissions control system. It will result in an automatic MOT failure , can void your vehicle insurance, and is harmful to the environment. Always choose professional cleaning or legitimate replacement over illegal modifications."
            },
            {
              "type": "paragraph",
              "text": "WHY EGR VALVES FAIL"
            }
          ],
          "links": [],
          "source": {
            "sectionId": "understanding-the-severity-of-your-egr-issue",
            "order": 0
          }
        }
      ]
    },
    "symptoms": {
      "items": [
        {
          "id": "the-three-common-failure-modes",
          "title": "THE THREE COMMON FAILURE MODES",
          "description": "The EGR valve is designed to reduce nitrogen oxide (NOx) emissions by recirculating exhaust gas back into the combustion chamber. While effective, this process introduces soot and unburnt fuel into the intake system.",
          "blocks": [
            {
              "type": "cards",
              "cards": [
                {
                  "title": "CARBON BUILD-UP (MOST COMMON)",
                  "text": "Frequent short journeys prevent the engine from reaching optimal operating temperature. This causes soot and oil vapour to condense and harden into a thick, tar-like carbon deposit, eventually jamming the valve open or closed.",
                  "highlight": "01",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "01 CARBON BUILD-UP (MOST COMMON) Frequent short journeys prevent the engine from reaching optimal operating temperature. This causes soot and oil vapour to condense and harden into a thick, tar-like carbon deposit, eventually jamming the valve open or closed."
                },
                {
                  "title": "MECHANICAL FAILURE",
                  "text": "Over time, the constant movement of the valve flap can cause the internal mechanism to wear out or seize, independent of carbon build-up.",
                  "highlight": "02",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "02 MECHANICAL FAILURE Over time, the constant movement of the valve flap can cause the internal mechanism to wear out or seize, independent of carbon build-up."
                },
                {
                  "title": "ELECTRICAL FAILURE",
                  "text": "Modern EGR valves are electronically controlled. Faulty wiring, blown fuses, or a failed internal solenoid can prevent the ECU from operating the valve, triggering an engine management light.",
                  "highlight": "03",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "03 ELECTRICAL FAILURE Modern EGR valves are electronically controlled. Faulty wiring, blown fuses, or a failed internal solenoid can prevent the ECU from operating the valve, triggering an engine management light."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Get an EGR diagnostic or cleaning quote Check symptoms first"
            },
            {
              "type": "paragraph",
              "text": "Get Quote"
            },
            {
              "type": "paragraph",
              "text": "CLEAN VS REPLACE – DECISION FRAMEWORK"
            }
          ],
          "links": [],
          "source": {
            "sectionId": "the-three-common-failure-modes",
            "order": 1
          }
        }
      ]
    },
    "causes": {
      "items": [
        {
          "id": "not-every-egr-fault-requires-a-new-part",
          "title": "NOT EVERY EGR FAULT REQUIRES A NEW PART",
          "description": "A proper diagnostic is essential to determine the most economical route.",
          "blocks": [
            {
              "type": "paragraph",
              "text": "🧹"
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "CHOOSE EGR CLEANING IF:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "The diagnostic scan indicates the valve is mechanically stuck due to carbon accumulation",
                "The valve’s electrical motor and housing are fully intact and functional",
                "Professional cleaning involves removing the valve and using chemical/ultrasonic processes to dissolve carbon"
              ]
            },
            {
              "type": "paragraph",
              "text": "◷ Labour: 1–3 hours"
            },
            {
              "type": "paragraph",
              "text": "OR"
            },
            {
              "type": "paragraph",
              "text": "⚙️"
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "CHOOSE EGR REPLACEMENT IF:"
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                "The diagnostic confirms the internal electrical motor or solenoid has failed",
                "The valve housing is cracked or the internal flap is physically broken",
                "Cleaning has already been attempted but the fault code returns immediately"
              ]
            },
            {
              "type": "paragraph",
              "text": "◷ Labour: 2–4 hours"
            },
            {
              "type": "paragraph",
              "text": "CONSEQUENCES OF DELAY"
            }
          ],
          "links": [],
          "source": {
            "sectionId": "not-every-egr-fault-requires-a-new-part",
            "order": 2
          }
        }
      ]
    },
