        {
          "id": "why-can-camshaft-failure-occur",
          "title": "Why can camshaft failure occur?",
          "description": "Camshaft failures can happen for a variety of reasons. Here are the most common causes.",
          "blocks": [
            {
              "type": "cards",
              "cards": [
                {
                  "title": "Poor lubrication",
                  "text": "Low oil levels, incorrect oil grade or infrequent changes can lead to excessive wear.",
                  "highlight": "01",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "01 Poor lubrication Low oil levels, incorrect oil grade or infrequent changes can lead to excessive wear."
                },
                {
                  "title": "Wear and fatigue",
                  "text": "Over time, camshafts can wear, especially in high-mileage vehicles.",
                  "highlight": "02",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "02 Wear and fatigue Over time, camshafts can wear, especially in high-mileage vehicles."
                },
                {
                  "title": "Timing system issues",
                  "text": "Faulty timing belts or chains can cause camshaft misalignment and damage.",
                  "highlight": "03",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "03 Timing system issues Faulty timing belts or chains can cause camshaft misalignment and damage."
                },
                {
                  "title": "Contamination",
                  "text": "Dirty oil or debris in the engine can accelerate wear and cause camshaft issues.",
                  "highlight": "04",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "04 Contamination Dirty oil or debris in the engine can accelerate wear and cause camshaft issues."
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Red flag engines - known failure patterns"
            }
          ],
