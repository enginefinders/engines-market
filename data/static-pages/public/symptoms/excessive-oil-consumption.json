    "faq": {
      "items": [
        {
          "id": "excessive-oil-consumption-faqs",
          "title": "Excessive oil consumption FAQs",
          "description": null,
          "blocks": [
            {
              "type": "faq",
              "question": "How much oil consumption is normal?",
              "answer": "Most manufacturers consider up to 0.5L per 1,000 miles acceptable. Anything above 1L per 1,000 miles needs investigation."
            },
            {
              "type": "faq",
              "question": "Can I use thicker oil to reduce consumption?",
              "answer": "It may help temporarily but masks the underlying issue. Always use the manufacturer-recommended oil viscosity."
            },
            {
              "type": "faq",
              "question": "How much does piston ring replacement cost in the UK?",
              "answer": "Piston ring replacement costs £1,500-£4,000+. The engine must be stripped down to access the pistons."
            },
            {
              "type": "faq",
              "question": "Will oil consumption fail an MOT?",
              "answer": "If there's visible blue smoke from the exhaust, yes. Otherwise, it may pass but the emissions test will show elevated hydrocarbons."
            }
          ],
          "links": [],
          "source": {
            "sectionId": "excessive-oil-consumption-faqs",
            "order": 10
          }
