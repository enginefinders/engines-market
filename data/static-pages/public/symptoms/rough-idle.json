          "title": "Rough idle FAQs",
          "description": null,
          "blocks": [
            {
              "type": "faq",
              "question": "How much does rough idle diagnosis cost in the UK?",
              "answer": "Rough idle diagnosis costs £50-£150 at UK independent garages. This includes fault code reading and basic inspection."
            },
            {
              "type": "faq",
              "question": "Can rough idle damage my car?",
              "answer": "Yes - if it's caused by a misfire, unburnt fuel can damage the catalytic converter (£500-£2,500)."
            },
            {
              "type": "faq",
              "question": "Is rough idle an MOT failure?",
              "answer": "Yes if it affects emissions or if the EML is on."
            },
            {
              "type": "faq",
              "question": "Can a fuel system cleaner fix rough idle?",
              "answer": "Sometimes - if it's a minor injector issue. But most cases need proper repairs."
            }
          ],
