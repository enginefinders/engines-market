        {
          "id": "engine-stalling-faqs",
          "title": "Engine stalling FAQs",
          "description": null,
          "blocks": [
            {
              "type": "faq",
              "question": "How much does engine stalling diagnosis cost in the UK?",
              "answer": "£50-£150 at UK independent garages. This includes fault code reading and basic inspection."
            },
            {
              "type": "faq",
              "question": "Is a stalling engine dangerous?",
              "answer": "Yes - especially at speed. You lose power steering and brake assistance. Pull over safely as soon as possible."
            },
            {
              "type": "faq",
              "question": "Can a dirty throttle body cause stalling?",
              "answer": "Yes - but it's less common than sensor or fuel system failure. A throttle body clean is often the first diagnostic step."
            },
            {
              "type": "faq",
              "question": "Can a fuel filter cause stalling?",
              "answer": "Yes. A blocked fuel filter restricts fuel flow, causing stalling under acceleration or at speed."
            }
          ],
          "links": [],
          "source": {
