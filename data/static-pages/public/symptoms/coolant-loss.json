    "faq": {
      "items": [
        {
          "id": "coolant-loss-faqs",
          "title": "Coolant loss FAQs",
          "description": null,
          "blocks": [
            {
              "type": "faq",
              "question": "Can I drive with a coolant leak?",
              "answer": "If it's a small leak and you're monitoring the level, you can drive short distances to a garage. If the temperature gauge rises or you see steam - stop immediately."
            },
            {
              "type": "faq",
              "question": "How much does a coolant leak repair cost in the UK?",
              "answer": "Coolant leak repair costs £50-£700+ depending on the cause. Hoses are cheap (£50-£200). Radiators and water pumps are more expensive (£300-£800)."
            },
            {
              "type": "faq",
              "question": "Is coolant loss always the head gasket?",
              "answer": "No. 45% of cases are external leaks (hoses, radiator, water pump). Head gasket failure accounts for 30% of cases."
            },
            {
              "type": "faq",
              "question": "What does coolant mixed with oil look like?",
              "answer": "A creamy, milky substance (like mayonnaise) on the dipstick or oil filler cap. This confirms head gasket failure."
            }
          ],
          "links": [],
          "source": {
            "sectionId": "coolant-loss-faqs",
            "order": 12
          }
        }
      ]
