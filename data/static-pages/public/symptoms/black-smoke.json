    "diagnosis": {
      "items": [
        {
          "id": "don-t-fall-for-these-common-misconceptions",
          "title": "Don't Fall for These Common Misconceptions",
          "description": "Avoid costly diagnostic mistakes and incorrect roadside remedies.",
          "blocks": [
            {
              "type": "cards",
              "cards": [
                {
                  "title": "",
                  "text": "“Black smoke is normal for diesel cars.” Some under hard acceleration, yes. Constant black smoke is not normal.",
                  "highlight": "",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "“Black smoke is normal for diesel cars.” Some under hard acceleration, yes. Constant black smoke is not normal."
                },
                {
                  "title": "",
                  "text": "“I'll just drive it harder to clear it out.” Italian tune-ups don't fix sensor or injector problems.",
                  "highlight": "",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "“I'll just drive it harder to clear it out.” Italian tune-ups don't fix sensor or injector problems."
                },
                {
                  "title": "",
                  "text": "“It's just the air filter; I'll change it.” Sometimes. But if the smoke continues, it's a sensor or injector.",
                  "highlight": "",
                  "meta": "",
                  "icon": "",
                  "items": [],
                  "fullText": "“It's just the air filter; I'll change it.” Sometimes. But if the smoke continues, it's a sensor or injector."
                },
                {
                  "title": "",
                  "text": "“Black smoke won't fail the MOT.” Visible black smoke from the exhaust is an automatic MOT failure.",
                  "highlight": "",
                  "meta": "",
                  "icon": "",
                  "items": [],
