    "faq": {
      "items": [
        {
          "id": "engine-won-t-start-faqs",
          "title": "Engine won't start FAQs",
          "description": null,
          "blocks": [
            {
              "type": "faq",
              "question": "What does it mean if my engine won't turn over?",
              "answer": "If the engine doesn't crank when you turn the key, it's either a dead battery, failed starter motor, or a seized engine. The most expensive is a seized engine."
            },
            {
              "type": "faq",
              "question": "Can a seized engine be fixed?",
              "answer": "No. Seized engines cannot be repaired - only replaced. The internal damage is too extensive."
            },
            {
              "type": "faq",
              "question": "How much does a starter motor replacement cost in the UK?",
              "answer": "Starter motor replacement costs £100-£400 depending on the vehicle. Labour accounts for most of the cost."
            },
            {
              "type": "faq",
              "question": "How much does an engine replacement cost in the UK?",
              "answer": "Engine replacement costs £1,500-£8,000+ depending on the vehicle and whether you choose used, rebuilt, or new."
            }
          ],
          "links": [],
          "source": {
            "sectionId": "engine-won-t-start-faqs",
            "order": 10
          }
        }
      ]
