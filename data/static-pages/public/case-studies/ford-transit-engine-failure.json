            {
              "type": "paragraph",
              "text": "Replace the parts, problem solved."
            },
            {
              "type": "paragraph",
              "text": "What it actually was"
            },
            {
              "type": "paragraph",
              "text": "Failed injectors causing bore wash"
            },
            {
