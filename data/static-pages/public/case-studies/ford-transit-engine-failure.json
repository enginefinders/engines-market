    "progression": {
      "items": [
        {
          "id": "1-200-in-wasted-repairs-and-the-same-problems-came-back-within-3-months",
          "title": "£1,200 in wasted repairs - and the same problems came back within 3 months.",
          "description": "The worn injectors were over-fuelling the engine. Unburnt diesel was washing the oil from the cylinder bores - a condition known as \"bore wash.\" This wore the piston rings, causing excessive oil consumption. The excess fuel was also rapidly clogging the new DPF.",
          "blocks": [
            {
              "type": "image",
