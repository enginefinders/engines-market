    "secondaryRisks": {
      "items": [
        {
          "id": "overheating-creates-risk-beyond-the-visible-head-crack",
          "title": "Overheating creates risk beyond the visible head crack.",
          "description": "When the specialist removed the cylinder head, they found visible cracking between the exhaust ports on cylinders 2 and 3. The engine had overheated before the owner stopped driving - overheating can cause cylinder bores to distort or piston rings to lose tension.",
          "blocks": [
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "Path A"
            },
            {
              "type": "paragraph",
              "text": "Replace only the cylinder head and head gasket - keep existing bottom end and turbos."
            },
            {
              "type": "paragraph",
              "text": "£2,800"
            },
            {
              "type": "paragraph",
              "text": "If bottom end fails later: add £2,000-£3,500. If turbos fail later: add £1,500-£2,500."
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "Path B"
            },
            {
              "type": "paragraph",
              "text": "Full engine rebuild - new head, timing set, oil pump, inspect bottom end."
            },
            {
              "type": "paragraph",
              "text": "£4,500"
            },
            {
              "type": "paragraph",
              "text": "Eliminates most post-repair risks. Full peace of mind."
            },
            {
              "type": "image",
              "src": "/case-studies/assets/5.1-vw-transporter-cfca-twin-turbo-risk.png",
              "alt": "VW CFCA twin turbo diagram showing oil contamination and coking risk from engine overheating",
              "width": "",
              "height": ""
            },
            {
              "type": "paragraph",
              "text": "The owner chose Path B - prioritising reliability for continued towing work. The CFCA has two turbochargers - both rely on clean oil. Overheating can cause oil to coke in the turbo oil feed lines."
            },
            {
              "type": "paragraph",
              "text": "Fork in the road"
            }
          ],
          "links": [],
          "source": {
            "sectionId": "overheating-creates-risk-beyond-the-visible-head-crack",
            "order": 5
          }
        }
      ]
    },
