    "initialSymptom": {
      "items": [
        {
          "id": "the-whole-repair-started-with-a-tiny-cold-start-rattle",
          "title": "The whole repair started with a tiny cold-start rattle.",
          "description": "The sound lasted only two or three seconds. That short window is why many owners ignore it until the timing chain has stretched far enough to trigger correlation faults.",
          "blocks": [
            {
              "type": "image",
              "src": "/case-studies/assets/1.2-jaguar-ingenium-cold-start-rattle.png",
              "alt": "Jaguar Ingenium cold start rattle sound wave - brief 2-second noise followed by silence",
              "width": "",
              "height": ""
            },
            {
              "type": "paragraph",
              "text": "What owner thought"
            },
            {
              "type": "paragraph",
              "text": "\"Just oil circulating\""
            },
            {
              "type": "paragraph",
              "text": "The car still drove normally, so the symptom did not feel urgent."
            },
            {
              "type": "paragraph",
              "text": "What it actually was"
            },
            {
              "type": "paragraph",
              "text": "Tensioner failure"
            },
            {
              "type": "paragraph",
              "text": "The Ingenium tensioner was losing pressure and allowing the chain to stretch."
            },
            {
              "type": "paragraph",
              "text": "Why it matters"
            },
            {
              "type": "paragraph",
              "text": "Guides shattered"
            },
            {
              "type": "paragraph",
              "text": "Plastic debris entered the oil pan, creating oil pump and turbo uncertainty."
            },
            {
              "type": "paragraph",
              "text": "If your Ingenium rattles for two seconds on cold start, book a timing chain inspection within seven days. Do not wait for P0011 or P0016 codes."
            },
            {
              "type": "paragraph",
              "text": "Failure timeline"
            }
          ],
          "links": [],
          "source": {
            "sectionId": "the-whole-repair-started-with-a-tiny-cold-start-rattle",
            "order": 1
          }
        }
      ]
    },
    "progression": {
      "items": [
        {
