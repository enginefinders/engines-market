    "secondaryRisks": {
      "items": [
        {
          "id": "a-failed-sdv6-crankshaft-can-send-debris-into-both-turbos",
          "title": "A failed SDV6 crankshaft can send debris into both turbos.",
          "description": "The SDV6 has two turbochargers, both fed by the same oil system that carried the failed bearing and crankshaft debris. If those particles score the turbo bearings, either turbo can fail weeks or months after the engine replacement.",
          "blocks": [
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "Path A"
            },
            {
              "type": "paragraph",
              "text": "Fit only the reconditioned engine and keep both existing turbos."
            },
            {
              "type": "paragraph",
              "text": "£8,500"
            },
            {
              "type": "paragraph",
              "text": "If one turbo fails later: add £1,500-£2,500 plus labour. If both fail, the risk doubles."
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "Path B"
            },
            {
              "type": "paragraph",
              "text": "Replace both turbos preventatively at the same time as the engine."
            },
            {
              "type": "paragraph",
              "text": "£10,750"
            },
            {
              "type": "paragraph",
              "text": "£8,500 engine + £2,250 for both turbos. Higher upfront cost, lower post-repair risk."
            },
            {
              "type": "image",
              "src": "/case-studies/assets/twin-turbo-debris.png",
              "alt": "Range Rover SDV6 twin turbo oil system diagram showing debris contamination path from crankshaft to both turbos",
              "width": "",
              "height": ""
            },
            {
              "type": "paragraph",
              "text": "Fork in the road"
            }
          ],
          "links": [],
