    "secondaryRisks": {
      "items": [
        {
          "id": "debris-contamination-created-risk-beyond-the-visible-failure",
          "title": "Debris contamination created risk beyond the visible failure.",
          "description": "When the specialist removed the oil filter and cut it open, they found significant amounts of metallic debris throughout the filter media. The turbocharger's oil supply comes directly from the main oil gallery - debris could have scored the turbo bearings.",
          "blocks": [
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "Path A"
            },
            {
              "type": "paragraph",
              "text": "Fit only the reconditioned engine and take the risk on existing ancillaries."
            },
            {
              "type": "paragraph",
              "text": "£5,500"
            },
            {
              "type": "paragraph",
              "text": "If turbo fails later: add £1,000-£1,800 + labour. If HPFP fails later: add £800-£1,500 + labour."
            },
            {
              "type": "heading",
              "level": "h3",
              "id": "",
              "text": "Path B"
            },
            {
              "type": "paragraph",
              "text": "Replace turbo, HPFP, and oil pump preventatively at the same time as the engine."
            },
            {
              "type": "paragraph",
              "text": "£7,200"
            },
            {
              "type": "paragraph",
              "text": "£5,500 engine + £1,700 for ancillaries. Eliminates all post-repair risks."
            },
            {
              "type": "image",
              "src": "/case-studies/assets/5.1-vw-amarok-cfca-ancillary-risk.png",
