    "initialSymptom": {
      "items": [
        {
          "id": "a-knocking-noise-that-started-faint-and-became-terminal-in-two-weeks",
          "title": "A knocking noise that started faint and became terminal in two weeks.",
          "description": "The knock was most noticeable at idle and would quieten slightly as the engine warmed up, but never disappeared completely. The owner had been using the Amarok for regular towing - a 1,500kg plant trailer several times a week.",
          "blocks": [
            {
              "type": "image",
              "src": "/case-studies/assets/1.2-vw-amarok-cfca-dealer-quote-shock.png",
              "alt": "VW Amarok engine quote comparison - dealer £12,000 versus specialist £5,500 saving £6,500",
              "width": "",
              "height": ""
            },
            {
              "type": "paragraph",
              "text": "What they thought"
            },
            {
              "type": "paragraph",
              "text": "\"Maybe a timing issue.\""
            },
            {
              "type": "paragraph",
              "text": "Hopefully not terminal. Hoping for a simple fix."
            },
            {
              "type": "paragraph",
              "text": "What it actually was"
            },
            {
              "type": "paragraph",
              "text": "Bottom-end failure"
            },
            {
              "type": "paragraph",
              "text": "Crankshaft seized. Metallic debris in oil. Complete failure."
            },
            {
              "type": "paragraph",
              "text": "The breaking point"
            },
            {
              "type": "paragraph",
              "text": "Engine wouldn't turn over"
            },
            {
              "type": "paragraph",
              "text": "Starter motor clicked, but crankshaft would not rotate. Vehicle recovered to dealer."
            },
            {
              "type": "paragraph",
              "text": "According to workshop consensus [INDUSTRY ESTIMATE], the CFCA BiTDI may be susceptible to crankshaft or bottom-end failure under certain conditions, particularly with high mileage or extended service intervals."
            },
            {
              "type": "paragraph",
              "text": "Failure timeline"
            }
          ],
          "links": [],
          "source": {
            "sectionId": "a-knocking-noise-that-started-faint-and-became-terminal-in-two-weeks",
            "order": 1
          }
        }
      ]
    },
