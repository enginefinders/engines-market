    "initialSymptom": {
      "items": [
        {
          "id": "the-cold-start-knock-was-not-just-injectors-settling",
          "title": "The cold-start knock was not \"just injectors settling.\"",
          "description": "Every cold morning began with a hammer-like knock for 20-30 seconds. Then came diesel smell in the cabin, intermittent DPF warnings, and fuel economy dropping from 38mpg to 22mpg.",
          "blocks": [
            {
              "type": "image",
              "src": "/case-studies/assets/black-death.png",
              "alt": "Jaguar AJD-V6 injector seal failure - heavy carbon buildup known as Black Death around injectors",
              "width": "",
              "height": ""
            },
            {
              "type": "paragraph",
              "text": "Symptom 1"
            },
            {
              "type": "paragraph",
              "text": "Cold-start knock"
            },
            {
              "type": "paragraph",
              "text": "Failed injector seals created carbon blow-by and a hammer-like start-up noise."
            },
            {
              "type": "paragraph",
              "text": "Symptom 2"
            },
            {
              "type": "paragraph",
              "text": "Diesel smell"
            },
            {
              "type": "paragraph",
              "text": "Combustion gases and diesel leakage made the fault noticeable inside the cabin."
            },
            {
              "type": "paragraph",
              "text": "Symptom 3"
            },
            {
              "type": "paragraph",
              "text": "DPF warning"
            },
            {
              "type": "paragraph",
              "text": "Incomplete combustion rapidly increased soot and ash loading in the DPF."
            },
            {
              "type": "paragraph",
              "text": "Multiple AJD-V6 symptoms usually mean the system is failing as a chain, not as one isolated fault. Injector seals, chains, DPF, oil dilution, and EGR faults can all accelerate each other."
            },
            {
              "type": "paragraph",
              "text": "Failure cascade"
            }
          ],
          "links": [],
          "source": {
            "sectionId": "the-cold-start-knock-was-not-just-injectors-settling",
            "order": 1
          }
        }
      ]
    },
    "progression": {
      "items": [
        {
          "id": "from-one-cold-start-knock-to-a-full-engine-decision",
          "title": "From one cold-start knock to a full engine decision.",
          "description": "This case did not fail in one dramatic motorway moment. It became expensive because the owner chased individual repairs while related faults continued to damage the wider engine system.",
          "blocks": [
            {
              "type": "image",
              "src": "/case-studies/assets/cascade-timeline.png",
              "alt": "Jaguar AJD-V6 cascade of failures timeline showing progression from cold-start knock to engine replacement",
