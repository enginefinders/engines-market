    "initialSymptom": {
      "items": [
        {
          "id": "from-mot-advisory-to-marbles-in-a-tin-can-in-just-three-weeks",
          "title": "From MOT advisory to \"marbles in a tin can\" in just three weeks.",
          "description": "Unlike a warning light, an MOT advisory can feel optional. In this case, the advisory was the cheapest warning the owner ever received.",
          "blocks": [
            {
              "type": "image",
              "src": "/case-studies/assets/1.2-range-rover-evoque-marbles-tin-can.png",
