    "progression": {
      "items": [
        {
          "id": "three-weeks-from-advisory-to-catastrophic-timing-jump",
          "title": "Three weeks from advisory to catastrophic timing jump.",
          "description": "The chain stretched while plastic and metal debris entered the oil pan. The owner assumed the advisory could wait until the next service.",
          "blocks": [
            {
              "type": "image",
              "src": "/case-studies/assets/2.2-range-rover-evoque-timeline.png",
              "alt": "Range Rover Evoque failure timeline from cold start rattle to MOT advisory to engine failure",
              "width": "",
              "height": ""
            },
            {
              "type": "paragraph",
              "text": "What the owner assumed"
            },
            {
              "type": "paragraph",
              "text": "\"Probably fine - it's only an advisory.\" The rattle was dismissed as normal diesel behaviour."
            },
            {
              "type": "paragraph",
              "text": "What was actually happening"
            },
            {
              "type": "paragraph",
              "text": "Failing tensioner, shattered guides, and a chain stretching beyond service limits before jumping three teeth."
            },
            {
              "type": "paragraph",
              "text": "\"The tester literally told me to get it checked. Three weeks later, I'm £4,500 poorer.\""
            },
