            "width": "",
            "height": ""
          },
          {
            "type": "image",
            "src": "/case-studies/assets/3.3-land-rover-discovery3-tdv6-damaged-block.png",
            "alt": "Land Rover TDV6 cylinder block destroyed by snapped crankshaft",
