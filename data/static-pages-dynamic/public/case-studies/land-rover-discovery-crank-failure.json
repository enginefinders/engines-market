            "height": ""
          },
          {
            "type": "paragraph",
            "text": "Oil condition"
          },
          {
            "type": "paragraph",
            "text": "Thick, black, containing metallic particles"
          },
          {
            "type": "paragraph",
            "text": "Oil filter"
          },
          {
            "type": "paragraph",
            "text": "Full of metal debris"
          },
          {
            "type": "paragraph",
            "text": "Crankshaft"
          },
          {
            "type": "paragraph",
            "text": "Snapped — complete failure between two main bearing journals"
          },
          {
            "type": "paragraph",
            "text": "Connecting rods"
          },
          {
            "type": "paragraph",
            "text": "One bent, one snapped"
          },
          {
            "type": "paragraph",
            "text": "Cylinder block"
          },
          {
            "type": "paragraph",
            "text": "Damaged — beyond repair"
          },
          {
            "type": "paragraph",
            "text": "Oil pump"
          },
          {
            "type": "paragraph",
            "text": "Destroyed by debris"
          },
          {
            "type": "paragraph",
            "text": "Turbocharger"
          },
          {
            "type": "paragraph",
            "text": "Unknown condition — potential debris contamination"
          },
          {
            "type": "paragraph",
            "text": "Specialist summary"
