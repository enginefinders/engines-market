      {
        "id": "frequently-asked-questions",
        "title": "Frequently Asked Questions",
        "description": null,
        "blocks": [
          {
            "type": "faq",
            "question": "How serious is engine knock?",
            "answer": "Engine knock is very serious. If it's mechanical (rod knock), continuing to drive can destroy the block. Immediate inspection is recommended."
          },
          {
            "type": "faq",
            "question": "Can I still drive with engine knock?",
            "answer": "Detonation knock allows gentle driving to a mechanic. If you hear a heavy rhythmic thudding that rises with RPM, turn off the engine immediately and arrange towing."
          },
          {
            "type": "faq",
            "question": "How much does it cost to fix engine knock?",
            "answer": "Simple decarbonisation or fuel issues range from £150-£400. Bearing replacements cost £800-£1,500, while complete engine replacements range from £2,500 upwards."
          },
          {
            "type": "faq",
            "question": "What causes engine knock?",
            "answer": "The primary causes are worn connecting rod bearings, low oil pressure, pre-ignition from incorrect fuel octane, or damaged timing components."
          },
          {
            "type": "faq",
            "question": "Can engine knock repair itself?",
            "answer": "No. Mechanical bearing damage is irreversible. Ignoring it will inevitably lead to total crankshaft and engine failure."
          },
          {
            "type": "faq",
            "question": "How can I prevent engine knock?",
            "answer": "Stick strictly to oil change intervals, check oil levels weekly, use high-grade manufacturer-specified fuel, and do not over-rev cold engines."
          },
