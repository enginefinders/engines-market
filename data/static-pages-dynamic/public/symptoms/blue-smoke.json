        "id": "blue-smoke-faqs",
        "title": "Blue Smoke FAQs",
        "description": "Common questions regarding oil burning, MOT emissions failures, and engine rebuild costs.",
        "blocks": [
          {
            "type": "faq",
            "question": "Why is my car blowing blue smoke on cold start? +",
            "answer": "Valve stem seals are leaking. Oil seeps past the seals when the engine is off and burns on start-up."
          },
          {
            "type": "faq",
            "question": "Can a turbo cause blue smoke? +",
            "answer": "Yes. Failing turbo seals allow oil into the intake or exhaust, causing constant blue smoke."
          },
          {
            "type": "faq",
            "question": "Is blue smoke an MOT failure? +",
            "answer": "Yes. Any visible blue smoke from the exhaust is an MOT failure (emissions test)."
          },
          {
            "type": "faq",
            "question": "How much does piston ring replacement cost in the UK? +",
            "answer": "Piston ring replacement costs £1,500-£4,000+. The engine must be stripped down to access the pistons."
          }
        ],
