        "blocks": [
          {
            "type": "faq",
            "question": "How much does loss of power diagnosis cost in the UK?",
            "answer": "Loss of power diagnosis costs £50-£150 at UK independent garages. This includes fault code reading and basic inspection."
          },
          {
            "type": "faq",
            "question": "Can loss of power be fixed with a service?",
            "answer": "Sometimes - if it's a blocked air or fuel filter. But in most cases, it's a sensor, injector, or turbo issue."
          },
          {
            "type": "faq",
            "question": "Should I drive with loss of power?",
            "answer": "If it's mild and there are no warning lights or noises, short journeys are possible. If there's knocking, rattling, or warning lights - stop driving."
          },
          {
            "type": "faq",
            "question": "How much does turbo failure cost in the UK?",
            "answer": "Turbo failure costs £450-£3,000+ depending on the vehicle and whether it's a rebuild or replacement."
          }
        ],
