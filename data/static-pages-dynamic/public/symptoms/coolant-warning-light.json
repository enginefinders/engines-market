      {
        "id": "coolant-warning-light-faqs",
        "title": "Coolant warning light FAQs",
        "description": null,
        "blocks": [
          {
            "type": "faq",
            "question": "What does the red thermometer light mean?",
            "answer": "Engine overheating. Stop driving immediately."
          },
          {
            "type": "faq",
            "question": "What does the yellow coolant wave light mean?",
            "answer": "Low coolant level. Check the level when the engine is cold."
          },
          {
            "type": "faq",
            "question": "Can I open the coolant reservoir when the engine is hot?",
            "answer": "No. Pressurised coolant can spray out and cause severe burns. Wait 30+ minutes."
          },
          {
            "type": "faq",
            "question": "How much does a coolant leak repair cost in the UK?",
            "answer": "Coolant leak repair costs £50-£700 depending on the cause. Hoses: £50-£200. Radiator: £300-£800."
          },
          {
            "type": "faq",
            "question": "Is the coolant light the same as the temperature gauge?",
            "answer": "They are related. The coolant light is a warning. The temperature gauge shows the actual temperature. If both indicate a problem - stop immediately."
          }
        ],
        "links": [],
