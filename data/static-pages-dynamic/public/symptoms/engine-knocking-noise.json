      {
        "id": "engine-knocking-noise-faqs",
        "title": "Engine knocking noise FAQs",
        "description": null,
        "blocks": [
          {
            "type": "faq",
            "question": "What's the difference between engine knocking and rattling?",
            "answer": "Knocking is a deep, rhythmic \"thud\" that increases with engine RPM. Rattling is a metallic, higher-pitched sound. Knocking indicates bearing failure - more serious."
          },
          {
            "type": "faq",
            "question": "Can low oil cause engine knocking?",
            "answer": "Yes. Low oil causes insufficient lubrication, leading to bearing wear and ultimately rod knock. Check your oil level immediately."
          },
          {
            "type": "faq",
            "question": "Is detonation the same as rod knock?",
            "answer": "No. Detonation sounds like marbles rattling and occurs under acceleration. Rod knock is a deep rhythmic knock at idle that worsens with RPM."
          },
          {
            "type": "faq",
            "question": "How much does rod knock repair cost in the UK?",
            "answer": "£800-£1,500 if caught early (bearing replacement only). £2,500-£10,000+ if crankshaft or block is damaged."
          }
        ],
        "links": [],
