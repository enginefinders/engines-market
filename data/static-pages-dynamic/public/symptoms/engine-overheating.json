        "id": "engine-overheating-faqs",
        "title": "Engine overheating FAQs",
        "description": null,
        "blocks": [
          {
            "type": "faq",
            "question": "How much does engine overheating repair cost in the UK?",
            "answer": "£80-£10,000+ depending on the cause and damage. Thermostat: £80-£300. Head gasket: £550-£2,000+. Engine replacement: £2,500-£10,000+."
          },
          {
            "type": "faq",
            "question": "Can an engine survive overheating?",
            "answer": "Yes - if you stop immediately. If you continue driving, the engine will be destroyed."
          },
          {
            "type": "faq",
            "question": "Why is overheating so damaging?",
            "answer": "Metal expands when hot. Cylinder heads warp, pistons seize, gaskets fail. Once the engine overheats, the damage is permanent."
          },
          {
            "type": "faq",
            "question": "What should I do if my car overheats on the motorway?",
            "answer": "Pull over safely onto the hard shoulder. Turn off the engine immediately. Call for recovery. Do not attempt to drive to the next exit."
          }
        ],
